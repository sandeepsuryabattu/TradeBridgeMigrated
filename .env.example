# === Kotak Neo API ===
KOTAK_CONSUMER_KEY=your_consumer_key_here
KOTAK_MOBILE_NUMBER=+919999999999
KOTAK_MPIN=123456
KOTAK_CLIENT_ID=your_client_id_here
KOTAK_TOTP_SECRET=your_totp_base32_secret

# === Telegram (from https://my.telegram.org) ===
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_CHANNEL_ID=-1001234567890

# === Trading Config ===
TRADING_MODE=paper
DEFAULT_LOT_SIZE=15
MAX_RISK_PER_TRADE=5000

# === API security (recommended) ===
# When set, mutating POST endpoints require header X-API-Token: <value>.
# Frontend on the same origin should send it; leave empty only for local dev.
API_TOKEN=change-me-to-a-long-random-string
# Comma-separated extra allowed CORS origins (FRONTEND_ORIGIN is always allowed)
FRONTEND_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=
# Set to 1 to emergency square-off real positions when the feed goes stale
STALE_FEED_SQUARE_OFF=0
